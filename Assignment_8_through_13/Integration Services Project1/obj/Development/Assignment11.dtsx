            <component
              refId="Package\Assignment 11\Creating_isflopping_istrending"
              componentClassID="Microsoft.DerivedColumn"
              contactInfo="Colonna derivata;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; Tutti i diritti sono riservati; http://www.microsoft.com/sql/support;0"
              description="Crea nuovi valori di colonna applicando espressioni alle colonne di input della trasformazione. Creare nuove colonne oppure sovrascrivere quelle esistenti. Ad esempio, concatenare i valori delle colonne 'first name' e 'last name' per creare una colonna 'full name'."
              name="Creating_isflopping_istrending"
              usesDispositions="true">
              <inputs>
                <input
                  refId="Package\Assignment 11\Creating_isflopping_istrending.Inputs[Input colonna derivata]"
                  description="Input della trasformazione Colonna derivata"
                  name="Input colonna derivata">
                  <inputColumns>
                    <inputColumn
                      refId="Package\Assignment 11\Creating_isflopping_istrending.Inputs[Input colonna derivata].Columns[AvgOtherFirsts]"
                      cachedDataType="r8"
                      cachedName="AvgOtherFirsts"
                      lineageId="Package\Assignment 11\Merge join.Outputs[Output merge join].Columns[AvgOtherFirsts]" />
                    <inputColumn
                      refId="Package\Assignment 11\Creating_isflopping_istrending.Inputs[Input colonna derivata].Columns[TotSongs]"
                      cachedDataType="ui8"
                      cachedName="TotSongs"
                      lineageId="Package\Assignment 11\Merge join.Outputs[Output merge join].Columns[TotSongs]" />
                    <inputColumn
                      refId="Package\Assignment 11\Creating_isflopping_istrending.Inputs[Input colonna derivata].Columns[AvgStreams]"
                      cachedDataType="r8"
                      cachedName="AvgStreams"
                      lineageId="Package\Assignment 11\Merge join.Outputs[Output merge join].Columns[AvgStreams]" />
                    <inputColumn
                      refId="Package\Assignment 11\Creating_isflopping_istrending.Inputs[Input colonna derivata].Columns[StDevStreams]"
                      cachedDataType="r8"
                      cachedName="StDevStreams"
                      lineageId="Package\Assignment 11\Merge join.Outputs[Output merge join].Columns[StDevStreams]" />
                    <inputColumn
                      refId="Package\Assignment 11\Creating_isflopping_istrending.Inputs[Input colonna derivata].Columns[Streams_First_Month]"
                      cachedDataType="i8"
                      cachedName="Streams_First_Month"
                      lineageId="Package\Assignment 11\Merge join.Outputs[Output merge join].Columns[Streams_First_Month]" />
                  </inputColumns>
                  <externalMetadataColumns />
                </input>
              </inputs>
              <outputs>
                <output
                  refId="Package\Assignment 11\Creating_isflopping_istrending.Outputs[Output colonna derivata]"
                  description="Output predefinito della trasformazione Colonna derivata"
                  exclusionGroup="1"
                  name="Output colonna derivata"
                  synchronousInputId="Package\Assignment 11\Creating_isflopping_istrending.Inputs[Input colonna derivata]">
                  <outputColumns>
                    <outputColumn
                      refId="Package\Assignment 11\Creating_isflopping_istrending.Outputs[Output colonna derivata].Columns[IsTrending]"
                      dataType="i4"
                      errorOrTruncationOperation="Calcolo"
                      errorRowDisposition="FailComponent"
                      lineageId="Package\Assignment 11\Creating_isflopping_istrending.Outputs[Output colonna derivata].Columns[IsTrending]"
                      name="IsTrending"
                      truncationRowDisposition="FailComponent">
                      <properties>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Espressione colonna derivata"
                          name="Expression">(#{Package\Assignment 11\Merge join.Outputs[Output merge join].Columns[TotSongs]} &gt; (DT_R8)2 &amp;&amp; #{Package\Assignment 11\Merge join.Outputs[Output merge join].Columns[Streams_First_Month]} &gt;= (#{Package\Assignment 11\Merge join.Outputs[Output merge join].Columns[AvgStreams]} + #{Package\Assignment 11\Merge join.Outputs[Output merge join].Columns[StDevStreams]})) || (#{Package\Assignment 11\Merge join.Outputs[Output merge join].Columns[TotSongs]} &lt;= (DT_R8)1 &amp;&amp; #{Package\Assignment 11\Merge join.Outputs[Output merge join].Columns[Streams_First_Month]} &gt;= #{Package\Assignment 11\Merge join.Outputs[Output merge join].Columns[AvgOtherFirsts]}) ? 1 : 0</property>
                        <property
                          containsID="true"
                          dataType="System.String"
                          description="Espressione descrittiva colonna derivata"
                          expressionType="Notify"
                          name="FriendlyExpression">(TotSongs &gt; (DT_R8)2 &amp;&amp; Streams_First_Month &gt;= (AvgStreams + StDevStreams)) || (TotSongs &lt;= (DT_R8)1 &amp;&amp; Streams_First_Month &gt;= AvgOtherFirsts) ? 1 : 0</property>
                      </properties>
                    </outputColumn>
                    <outputColumn
                      refId="Package\Assignment 11\Creating_isflopping_istrending.Outputs[Output colonna derivata].Columns[IsFlopping]"
                      dataType="i4"
