  <Source dwd:design-time-name="6c77d69f-c28e-4336-b861-58a78f73626f">
    <DataSourceViewID>Group4_DSV</DataSourceViewID>
  </Source>
  <MdxScripts>
    <MdxScript dwd:design-time-name="e76f1b7d-3045-4ea2-ba53-ebeef32b616f">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
Il comando CALCULATE controlla l'aggregazione delle celle foglia nel cubo.
L'eliminazione o la modifica del comando CALCULATE influisce sui dati nel cubo.
È consigliabile modificare il comando solo se si specifica manualmente la modalità di aggregazione del cubo.
*/
CALCULATE;  
CREATE MEMBER CURRENTCUBE.[Measures].AvgWeightedStreams
 AS IIF(
    [Measures].[Published Song Fact Count] = 0,
    NULL,
    [Measures].[Weighted Streams] / [Measures].[Published Song Fact Count]
), 
FORMAT_STRING = "#.##0,00;-#.##0,00", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].StreamChange
 AS [Measures].[Streams First Month] - [Measures].[Stream Previous], 
FORMAT_STRING = "#.##0,00;-#.##0,00", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].StreamsByMinute
 AS IIF(
    [Measures].[Duration Sec] = 0,
    NULL,
    [Measures].[Streams First Month] / ([Measures].[Duration Sec] / 60)
), 
FORMAT_STRING = "#.##0,00;-#.##0,00", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].WeightedStreams
 AS [Measures].[Streams First Month] * [Measures].[Duration Sec], 
FORMAT_STRING = "#.##0,00;-#.##0,00", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].PreviousStreams
 AS IIF( [Dim Date].[Year].CurrentMember.PrevMember IS NULL, NULL,
            ([Dim Date].[Year].CurrentMember.PrevMember,[Dim Date].[Season].CurrentMember, [Measures].[Streams First Month])
        ), 
FORMAT_STRING = "#.##0,00;-#.##0,00", 
VISIBLE = 1  ; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
</Cube>